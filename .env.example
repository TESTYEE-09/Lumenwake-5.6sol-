# Create a key in the Fireworks AI dashboard.
FIREWORKS_API_KEY=your_key_here

# DeepSeek V4 Flash on Fireworks serverless.
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash

# Optional server settings.
PORT=8787
FIREWORKS_OFFLINE=false

# Optional frontend setting for a separately deployed Express backend.
# Do not include a trailing slash.
# VITE_STORY_API_URL=https://your-api.example.com
